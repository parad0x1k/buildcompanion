# TypeScript sources — compiled/bundled output is in dist/ (see esbuild.js)
src/
extension.ts
tsconfig.json

# out/ (tsc's per-file output, used only by the test suite) and node_modules/ (inlined into
# dist/extension.js by esbuild) are no longer needed at runtime now that "main" points at the
# bundled dist/extension.js — see esbuild.js.
out/
node_modules/

# Source maps — keep .js only for distribution
**/*.js.map

# Design and internal documentation
design-docs/

# Audit and dependency reports
audit-fix-dry-run.json
audit-report.json
outdated-report.json
deps-top.txt

# VS Code workspace configuration
.vscode/
.github/
.gitignore

# Local MCP server configuration (personal tool setup, not part of the extension)
.mcp.json

# Generated packages
*.vsix

# Unused resource image variants (only resources/marketplace-icon.png and resources/codebuild.svg are referenced)
resources/marketplace-icon.svg
resources/marketplace-icon1.png
resources/Media.jpeg
resources/icon-drafts/

# README demo GIFs — large captures rendered from GitHub via "markdown": "github", excluded from the packaged extension
resources/gifs/

# Dev tooling
.eslintrc*
.prettierrc*
.editorconfig
