{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "rootDir": "src",
    "outDir": "out",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vscode",
      "mocha"
    ],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node16",
    // true: avoids type-checking vendored .d.ts files (e.g. aws-sdk-client-mock's nested,
    // version-conflicting @types/sinon copy used only by the test suite); our own src/**
    // files are always fully checked regardless of this setting.
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}